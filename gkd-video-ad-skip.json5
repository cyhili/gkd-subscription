// =============================================================
//  GKD 订阅规则：抖音 / 红果 短剧广告自动滑走
//  校准依据：2026-11 真实广告截图（图1/图2 = 读秒锁定中，图3 = 读秒结束）
//  导入：GKD App → 订阅 → 新建本地订阅 → 把对应 app 整段粘入（一次一个应用）
//        或直接把本文件作为订阅链接导入
//  ⚠️ 选择器请用 GKD「快照审查」(i.gkd.li/import) 在你手机上复核对齐
//  ⚠️ 修正：原版用了 GKD 不支持的 delayTriggerTime 与数组坐标、逗号分隔，
//    已改为「倒计时剩1秒/0秒时匹配 + {x,y} 对象坐标 + || 或」的合法写法。
// =============================================================
{
  id: 1001001,
  name: '视频广告自动滑走（抖音/红果短剧）',
  version: 4,
  author: 'your-name',
  apps: [
    // ==================== 抖音 ====================
    // 包名: com.ss.android.ugc.aweme
    {
      id: 'com.ss.android.ugc.aweme',
      name: '抖音',
      groups: [
        {
          // 核心逻辑：普通短剧底部永远是「上滑继续看下一集」，绝不会出现「X秒后可继续」；
          // 只有【广告在读秒锁定中】才显示「🔒 N 秒后可继续看下一集 ｜ 付费免广告」。
          // 读秒锁定中的文本会逐秒变化，当变成「1秒后/0秒后…」即接近结束，
          // 此刻上滑正好把广告划走（GKD 合法的时间判断写法，不用 delayTriggerTime）。
          key: 100030,
          name: '抖音短剧-广告读秒结束前上滑',
          // activityIds: [],  // 可选，填抖音短剧页 activity 可缩小触发范围
          rules: [
            {
              key: 0,
              name: '倒计时剩1秒/0秒时上滑划走',
              matches: '[text*="1秒后可继续看下一集" || text*="0秒后可继续看下一集"]',
              action: 'swipe',
              swipeArg: {
                // 屏幕绝对坐标：下方 75% 滑到 25% = 抖音「下一条/下一集」手势
                start: { x: 'screenWidth/2', y: 'screenHeight * 0.75' },
                end: { x: 'screenWidth/2', y: 'screenHeight * 0.25' },
                duration: 300,
              },
              actionMaximum: 1,
              resetMatch: 'match',
            },
          ],
        },
        // 备选：信息流/插屏里「必须点跳过」的限时广告
        // 读秒中按钮显示数字，结束才变成「跳过」，故只在可跳时点，不误点数字。
        {
          key: 100031,
          name: '抖音-点击「跳过」按钮（限时广告）',
          rules: [
            {
              key: 0,
              name: '出现可点的「跳过」时点击',
              // ^="跳过" 表示以「跳过」开头，规避「跳过5」「3s跳过」等倒计时数字态
              matches: '[text^="跳过"]',
              action: 'click',
            },
          ],
        },
        // —— 激进版：检测「图3」就上滑（跳过正片，默认关闭）——
        // ⚠️ 广告读秒后(图3)底部是「上滑继续看下一集」且「广告」标签已消失，
        //    这与正片短剧的文字【完全相同】，开启后会把想看的正片也一起滑掉。
        {
          key: 100032,
          name: '抖音短剧-检测上滑提示就上滑（激进/跳过正片）',
          enable: false,
          rules: [
            {
              key: 0,
              name: '检测到「上滑继续看下一集」就上滑',
              matches: '[text*="上滑继续看下一集"]',
              action: 'swipe',
              swipeArg: {
                start: { x: 'screenWidth/2', y: 'screenHeight * 0.75' },
                end: { x: 'screenWidth/2', y: 'screenHeight * 0.25' },
                duration: 300,
              },
            },
          ],
        },
      ],
    },
    // ==================== 红果免费短剧 ====================
    // 包名: com.phoenix.read
    // ⚠️ 红果未提供截图，以下为模板。若红果也有「X秒后可继续看下一集」这类
    //    读秒锁定提示，逻辑与抖音一致；若红果文案不同（如「X秒后播放」），
    //    请把 matches 里的关键字改成红果实际文字。
    {
      id: 'com.phoenix.read',
      name: '红果免费短剧',
      groups: [
        {
          key: 200030,
          name: '红果短剧-广告读秒结束前上滑',
          // activityIds: ['com.dragon.read.component.shortvideo.impl.ShortSeriesActivity'],
          rules: [
            {
              key: 0,
              name: '倒计时剩1秒/0秒时上滑划走',
              // || 为「或」：同时兼容红果把提示挂在 text 或 desc 上的情况
              matches: '[text*="1秒后可继续看下一集" || text*="0秒后可继续看下一集"] || [desc*="1秒后可继续看下一集" || desc*="0秒后可继续看下一集"]',
              action: 'swipe',
              swipeArg: {
                start: { x: 'screenWidth/2', y: 'screenHeight * 0.75' },
                end: { x: 'screenWidth/2', y: 'screenHeight * 0.25' },
                duration: 300,
              },
              actionMaximum: 1,
              resetMatch: 'match',
            },
          ],
        },
      ],
    },
  ],
}
