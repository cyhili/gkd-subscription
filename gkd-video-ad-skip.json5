{
  "id": 1001001,
  "name": "视频广告自动滑走（抖音/红果短剧）",
  "version": 3,
  "author": "your-name",
  "apps": [
    {
      "id": "com.ss.android.ugc.aweme",
      "name": "抖音",
      "groups": [
        {
          "key": 100030,
          "name": "抖音短剧-广告读秒后自动上滑",
          "rules": [
            {
              "key": 0,
              "name": "读秒锁定中识别广告 → 延迟到读秒结束再上滑",
              "matches": "[text*=\"秒后可继续\"]",
              "action": "swipe",
              "swipeArg": {
                "start": [
                  0.5,
                  0.75
                ],
                "end": [
                  0.5,
                  0.25
                ],
                "duration": 300
              },
              "delayTriggerTime": 6000
            }
          ]
        },
        {
          "key": 100031,
          "name": "抖音-点击「跳过」按钮（限时广告）",
          "rules": [
            {
              "key": 0,
              "name": "出现可点的「跳过」时点击",
              "matches": "[text^=\"跳过\"]",
              "action": "click"
            }
          ]
        },
        {
          "key": 100032,
          "name": "抖音短剧-检测上滑提示就上滑（激进/跳过正片）",
          "enable": false,
          "rules": [
            {
              "key": 0,
              "name": "检测到「上滑继续看下一集」就上滑（即图3状态）",
              "matches": "[text*=\"上滑继续看下一集\"]",
              "action": "swipe",
              "swipeArg": {
                "start": [
                  0.5,
                  0.75
                ],
                "end": [
                  0.5,
                  0.25
                ],
                "duration": 300
              }
            }
          ]
        }
      ]
    },
    {
      "id": "com.phoenix.read",
      "name": "红果免费短剧",
      "groups": [
        {
          "key": 200030,
          "name": "红果短剧-广告读秒后自动上滑",
          "rules": [
            {
              "key": 0,
              "name": "读秒锁定中识别广告 → 延迟到读秒结束再上滑",
              "matches": "[text*=\"秒后可继续\"], [desc*=\"秒后可继续\"]",
              "action": "swipe",
              "swipeArg": {
                "start": [
                  0.5,
                  0.75
                ],
                "end": [
                  0.5,
                  0.25
                ],
                "duration": 300
              },
              "delayTriggerTime": 6000
            }
          ]
        }
      ]
    }
  ]
}
