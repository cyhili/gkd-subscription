// =============================================================
//  GKD 订阅规则：抖音 / 红果 短剧广告自动滑走
//  校准依据：2026-11 真实广告截图（图1/图2 = 读秒锁定中，图3 = 读秒结束）
//  导入：GKD App → 订阅 → 新建本地订阅 → 把对应 app 整段粘入（一次一个应用）
//        或直接把本文件作为订阅链接导入
//  ⚠️ 选择器请用 GKD「快照审查」(i.gkd.li/import) 在你手机上复核对齐
// =============================================================

{
  id: 1001001,
  name: '视频广告自动滑走（抖音/红果短剧）',
  version: 3,
  author: 'your-name',

  apps: [
    // ==================== 抖音 ====================
    // 包名: com.ss.android.ugc.aweme
    {
      id: 'com.ss.android.ugc.aweme',
      name: '抖音',
      groups: [
        {
          // 核心逻辑（已按截图校准）：
          // 普通短剧底部永远是「上滑继续看下一集」，绝不会出现「X秒后可继续」；
          // 只有【广告在读秒锁定中】才显示「🔒 N 秒后可继续看下一集 ｜ 付费免广告」。
          // 所以 text*="秒后可继续" 能 100% 锁定「这是广告且正被锁住」这一状态。
          // —— 关键：图3（读秒结束后）「广告」标签会消失，底部变回和普通短剧
          //    一样的「上滑继续看下一集」，静态规则无法在图3区分广告与正片，
          //    因此必须在「读秒锁定中」就锁定广告，并用 delayTriggerTime 把上滑
          //    延迟到读秒结束再执行。swipe 用屏幕绝对坐标，不依赖会消失的节点。
          key: 100030,
          name: '抖音短剧-广告读秒后自动上滑',
          // activityIds: [],  // 可选。抖音短剧页通常为 MainActivity 内播放层；
          //                    不填纯靠文字判定已足够精准。想更稳就用快照拿到
          //                    短剧 activity 后填在此处（如填入可缩小触发范围）。
          rules: [
            {
              key: 0,
              name: '读秒锁定中识别广告 → 延迟到读秒结束再上滑',
              matches: '[text*="秒后可继续"]', // 锁定态=广告（普通短剧无此文本）
              action: 'swipe',
              swipeArg: {
                // 屏幕绝对坐标：下方 75% 滑到 25% = 抖音「下一条/下一集」手势
                start: ['screenWidth/2', 'screenHeight*0.75'],
                end: ['screenWidth/2', 'screenHeight*0.25'],
                duration: 300,
              },
              // 延迟到读秒结束再执行。抖音短剧广告读秒常见 1~5 秒，6000ms 可覆盖绝大多数；
              // 若遇到更长的读秒（如激励广告 15s），把它调大到 16000 即可。
              // 即使「秒后可继续」节点在我计时期间消失，swipe 用的是绝对坐标，到点仍会执行。
              delayTriggerTime: 6000,
              // snapshotUrls: [],  // 把你在抖音短剧广告界面抓的快照 url 填这里
            },
          ],
        },

        // 备选：信息流/插屏里「必须点跳过」的限时广告
        // 读秒中按钮显示数字，结束才变成「跳过」，故只在可跳时点，不误点数字。
        {
          key: 100031,
          name: '抖音-点击「跳过」按钮（限时广告）',
          rules: [
            {
              key: 0,
              name: '出现可点的「跳过」时点击',
              // ^="跳过" 表示以「跳过」开头，规避「跳过5」「3s跳过」等倒计时数字态
              matches: '[text^="跳过"]',
              action: 'click',
              // 若你版本把倒计时写成「3s 跳过」而 ^="跳过" 仍命中，可加：
              // excludeMatches: '[text*="s"]'
            },
          ],
        },

        // —— 激进版：检测「图3」就上滑 ——
        // ⚠️ 关键：广告读秒后(图3)底部是「上滑继续看下一集」且「广告」标签已消失，
        //    这与正片短剧的文字【完全相同】。所以本组一旦开启，会连你想看的正片一起滑掉。
        //    仅在你想「所有短剧自动过完(含正片)」时，把 enable 改为 true。
        {
          key: 100032,
          name: '抖音短剧-检测上滑提示就上滑（激进/跳过正片）',
          enable: false,
          rules: [
            {
              key: 0,
              name: '检测到「上滑继续看下一集」就上滑（即图3状态）',
              // 读秒锁定中(含「秒后可继续」)不含此文本，故不会在锁定时乱滑；
              // 仅在读秒结束(图3) 或 正片 时匹配 —— 正片也会被滑。
              matches: '[text*="上滑继续看下一集"]',
              action: 'swipe',
              swipeArg: {
                start: ['screenWidth/2', 'screenHeight*0.75'],
                end: ['screenWidth/2', 'screenHeight*0.25'],
                duration: 300,
              },
            },
          ],
        },
      ],
    },

    // ==================== 红果免费短剧 ====================
    // 包名: com.phoenix.read
    // ⚠️ 红果未提供截图，以下为模板。若红果也有「X秒后可继续看下一集」这类
    //    读秒锁定提示，逻辑与抖音完全一致；若红果文案不同（如「X秒后播放」），
    //    请把 matches 里的关键字改成红果实际文字。
    {
      id: 'com.phoenix.read',
      name: '红果免费短剧',
      groups: [
        {
          key: 200030,
          name: '红果短剧-广告读秒后自动上滑',
          // activityIds: ['com.dragon.read.component.shortvideo.impl.ShortSeriesActivity'],
          rules: [
            {
              key: 0,
              name: '读秒锁定中识别广告 → 延迟到读秒结束再上滑',
              // 逗号分隔 = 「或」：同时兼容红果把提示挂在 text 或 desc 上的情况
              matches: '[text*="秒后可继续"], [desc*="秒后可继续"]',
              action: 'swipe',
              swipeArg: {
                start: ['screenWidth/2', 'screenHeight*0.75'],
                end: ['screenWidth/2', 'screenHeight*0.25'],
                duration: 300,
              },
              delayTriggerTime: 6000,
            },
          ],
        },
      ],
    },
  ],
}
