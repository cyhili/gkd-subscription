{
  // 抖音 / 红果短剧 —— 刷到广告自动上滑划走
  id: 20261102,
  name: '抖音红果划广告',
  version: 8,
  author: 'cyhili',
  categories: [
    { key: 0, name: '信息流广告-划走', enable: true },
    { key: 1, name: '广告检测提示', enable: true },
  ],
  globalGroups: [],
  apps: [
    // ===================== 抖音 =====================
    {
      id: 'com.ss.android.ugc.aweme',
      name: '抖音',
      groups: [
        {
          key: 0,
          name: '功能类-刷到广告/推广视频时[上滑划走]',
          desc: '带倒计时的付费广告等倒计时剩1秒才上滑；普通广告立即上滑；均用长距滑动确保切到下一条',
          fastQuery: true,
          rules: [
            {
              key: 0,
              name: '倒计时广告-剩1秒时上滑划走',
              actionCd: 1500,
              actionMaximum: 2,
              resetMatch: 'match',
              actionDelay: 200,
              swipeArg: {
                start: { x: 'screenWidth/2', y: 'screenHeight * 0.78' },
                end: { x: 'screenWidth/2', y: 'screenHeight * 0.22' },
                duration: 300,
              },
              matches: '[text^="1秒后可继续看下一集" || text^="0秒后可继续看下一集"][visibleToUser=true]',
            },
            {
              key: 1,
              name: '普通广告-立即上滑划走',
              actionCd: 1200,
              actionMaximum: 2,
              resetMatch: 'match',
              actionDelay: 200,
              swipeArg: {
                start: { x: 'screenWidth/2', y: 'screenHeight * 0.78' },
                end: { x: 'screenWidth/2', y: 'screenHeight * 0.22' },
                duration: 300,
              },
              excludeMatches: '[text*="秒后可继续看下一集"]',
              matches: '([visibleToUser=true] > [text$="广告" || text$="（推广）"][vid="desc" || desc="广告"]) || ([text="广告"][visibleToUser=true][width<300][height<150]) || ([text*="付费免广告"][visibleToUser=true]) || ([text="应用" || text="购物" || text="咨询" || text="服务" || text="预约" || text="子薇剧场"][text.length<6][index=1][visibleToUser=true]) || (ViewGroup[childCount=5] > ImageView +3 [text^="已售" || text^=" 已售"] - TextView - [text="讲解中 丨 "][index=1][visibleToUser=true])',
            },
          ],
        },
        {
          key: 1,
          name: '功能类-广告反馈问卷[上滑划走]',
          desc: '划走广告后抖音会弹出"你认为这个内容是【广告】吗？"，自动上滑跳过',
          fastQuery: true,
          rules: [
            {
              key: 0,
              actionCd: 2000,
              actionMaximum: 1,
              resetMatch: 'match',
              swipeArg: {
                start: { x: 'screenWidth/2', y: 'screenHeight * 0.78' },
                end: { x: 'screenWidth/2', y: 'screenHeight * 0.22' },
                duration: 300,
              },
              activityIds: '.detail.ui.DetailActivity',
              matches: 'UIText[text="你认为这个内容是【广告】吗？"][visibleToUser=true]',
            },
          ],
        },
        {
          key: 2,
          name: '功能类-广告检测提示[仅记录不操作]',
          desc: '只要检测到广告特征就触发一次(不滑动)，用于在“触发记录”里确认检测是否生效，方便调试',
          fastQuery: true,
          rules: [
            {
              key: 0,
              action: 'none',
              actionCd: 2000,
              anyMatches: [
                '[text="广告"]',
                '[text*="付费免广告"]',
                '[text*="秒后可继续看下一集"]',
                '[text*="了解详情"]',
                '[text*="查看详情"]',
                '[text*="立即下载"]',
                '[text*="立即购买"]',
              ],
            },
          ],
        },
      ],
    },
    // ===================== 红果短剧（国内版） =====================
    {
      id: 'com.phoenix.read',
      name: '红果短剧',
      groups: [
        {
          key: 0,
          name: '功能类-刷到广告[上滑划走]',
          desc: '红果刷剧时检测到带"广告"标识的视频，长距上滑划走',
          fastQuery: true,
          rules: [
            {
              key: 0,
              actionCd: 2000,
              actionMaximum: 1,
              resetMatch: 'match',
              swipeArg: {
                start: { x: 'screenWidth * 0.5', y: 'screenHeight * 0.8' },
                end: { x: 'screenWidth * 0.5', y: 'screenHeight * 0.2' },
                duration: 300,
              },
              activityIds: 'com.dragon.read.pages.main.MainFragmentActivity',
              matches: '[vid="ad_source"][visibleToUser=true]',
            },
          ],
        },
      ],
    },
    // ===================== 红果短剧（Google Play 海外版，如已安装则启用） =====================
    {
      id: 'com.phoenix.read.oversea.gp',
      name: '红果短剧-海外版',
      groups: [
        {
          key: 0,
          name: '功能类-刷到广告[上滑划走]',
          desc: '红果刷剧时检测到带"广告"标识的视频，长距上滑划走',
          fastQuery: true,
          rules: [
            {
              key: 0,
              actionCd: 2000,
              actionMaximum: 1,
              resetMatch: 'match',
              swipeArg: {
                start: { x: 'screenWidth * 0.5', y: 'screenHeight * 0.8' },
                end: { x: 'screenWidth * 0.5', y: 'screenHeight * 0.2' },
                duration: 300,
              },
              activityIds: 'com.dragon.read.pages.main.MainFragmentActivity',
              matches: '[vid="ad_source"][visibleToUser=true]',
            },
          ],
        },
      ],
    },
  ],
}
